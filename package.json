{
  "name": "@okee-tech/pocketbase-cli",
  "description": "PocketBase CLI tool to manage PocketBase instances and projects",
  "version": "0.0.1",
  "author": "OKEE Tech",
  "bin": {
    "pocketbase": "./bin/run.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "bugs": "https://github.com/okee-tech/pocketbase-cli/issues",
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "@oclif/core": "^4",
    "@oclif/plugin-help": "^6",
    "@oclif/plugin-plugins": "^5",
    "chalk": "^5.6.2",
    "docker-compose": "^1.3.0",
    "dockerode": "^4.0.9",
    "dotenv": "^17.2.3",
    "hash-sum": "^2.0.0",
    "neverthrow": "^8.2.0",
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/compat": "^1",
    "@oclif/prettier-config": "^0.2.1",
    "@oclif/test": "^4",
    "@okee-tech/eslint-plugin-neverthrow": "^1.0.13",
    "@types/chai": "^5",
    "@types/copyfiles": "^2.4.4",
    "@types/dockerode": "^3.3.45",
    "@types/hash-sum": "^1.0.2",
    "@types/mocha": "^10",
    "@types/node": "^24",
    "chai": "^6",
    "copyfiles": "^2.4.1",
    "eslint": "^9",
    "eslint-config-oclif": "^6",
    "eslint-config-prettier": "^10",
    "mocha": "^11",
    "npm-run-all": "^4.1.5",
    "oclif": "^4",
    "shx": "^0.4.0",
    "ts-node": "^10",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "./bin",
    "./dist",
    "./oclif.manifest.json"
  ],
  "homepage": "https://github.com/okee-tech/pocketbase-cli",
  "keywords": [
    "oclif",
    "pocketbase",
    "cli"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "type": "module",
  "oclif": {
    "bin": "pocketbase",
    "dirname": "pocketbase",
    "commands": "./dist/commands",
    "plugins": [
      "@oclif/plugin-help"
    ],
    "topicSeparator": " ",
    "topics": {
      "hello": {
        "description": "Say hello to the world and others"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/okee-tech/pocketbase-cli.git"
  },
  "scripts": {
    "build": "npm-run-all clean build:raw copy:samples",
    "build:raw": " tsc -b",
    "clean": "shx rm -rf dist",
    "copy:samples": "copyfiles -a -u 1 src/samples/**/* dist/",
    "lint": "eslint",
    "postpack": "shx rm -f oclif.manifest.json",
    "posttest": "npm run lint",
    "prepack": "oclif manifest && oclif readme",
    "test": "mocha --forbid-only \"test/**/*.test.ts\"",
    "version": "oclif readme && git add README.md"
  },
  "types": "dist/index.d.ts"
}
